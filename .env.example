# Copy this file to .env for your own installation. Never commit .env.
# Uncomment settings you want to override. Commented values show the defaults.
HOST=127.0.0.1
PORT=4173
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:4173
# APP_NAME="Shift Handover"
# TEAM_NAME="Sua equipe"

# One Jira Cloud project per installation. Leave the site/credentials empty for manual mode.
# JIRA_SITE_URL=
# JIRA_PROJECT_KEY=OPS
# JIRA_BASE_JQL=
# JIRA_FILTER_LABEL=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# Empty: derive the callback from APP_ORIGIN (or the local PORT).
# JIRA_REDIRECT_URI=
# JIRA_SESSION_DAYS=30
# Non-Windows servers: inject a base64 key containing exactly 32 random bytes.
# Use your secret manager. Never put a real key in this example or a commit.
# JIRA_SESSION_KEY=

# Google Chat incoming webhook; leave empty for preview-only operation.
# CHAT_WEBHOOK_URL=

# Optional absolute paths. Leave unset to use the installation defaults.
# HANDOFF_DATA_DIR=
# HANDOVER_CONFIG_DIR=
